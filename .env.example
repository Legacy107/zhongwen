# local dev: docker compose up
DATABASE_URL="postgresql://chinese:chinese@localhost:5433/chinese"

# Gate for /api/sync and (later) the LLM proxy, entered at /signin.
# Required in production. In development, leave APP_PASSPHRASE unset to sync
# without signing in.
APP_PASSPHRASE="change-me"
# Signs the sign-in cookie. Rotating it signs every device out.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
